<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp">

    <TextView
        android:id="@+id/app_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="24dp"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp"
        tools:ignore="HardcodedText"
        tools:text="v1.0.0" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/appearance"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/theme_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/theme_system"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_system" />

        <RadioButton
            android:id="@+id/theme_light"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_light" />

        <RadioButton
            android:id="@+id/theme_dark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/theme_dark" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/site_mode"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/site_mode_group"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/site_mode_mobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/site_mode_mobile" />

        <RadioButton
            android:id="@+id/site_mode_desktop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/site_mode_desktop" />
    </RadioGroup>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/video_playback"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/video_thumbnail_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/show_thumbnail_for_videos_accessibility"
        android:text="@string/show_thumbnail_for_videos"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/show_thumbnail_for_videos_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/diagnostics"
        android:textStyle="bold" />

    <Switch
        android:id="@+id/stats_for_nerds_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/stats_for_nerds_accessibility"
        android:text="@string/stats_for_nerds"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/stats_for_nerds_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <Switch
        android:id="@+id/logging_switch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/enable_logging_accessibility"
        android:text="@string/enable_logging"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        android:text="@string/enable_logging_summary"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/share_log_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/share_log" />

        <Button
            android:id="@+id/clear_log_button"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/clear_log" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/navigation"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/navigation_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="8dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/back_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/back"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            app:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/forward_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/forward"
            android:scaleType="centerInside"
            android:src="@drawable/ic_forward"
            app:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/refresh_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/refresh"
            android:scaleType="centerInside"
            android:src="@drawable/ic_refresh"
            app:tint="?android:attr/textColorPrimary" />

        <ImageButton
            android:id="@+id/home_button"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/home"
            android:scaleType="centerInside"
            android:src="@drawable/ic_home"
            app:tint="?android:attr/textColorPrimary" />
    </LinearLayout>
</LinearLayout>
